MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/whiteboard-sat
DESMOS_KEY=

# openssl rand -base64 48  — a guessable value here forges any session
JWT_SECRET=

# Transactional email (verification + password reset). Left blank in
# development, the links are logged to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=White Board SAT <noreply@yourdomain.com>

# Only needed if the request origin is wrong behind a proxy, for link building.
APP_URL=

# Cloudflare R2 Object Storage (for question figures, diagrams, and media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
